{
  "name": "gpt-image-playground",
  "private": true,
  "version": "0.5.5",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "dev:api": "pnpm --filter @gpt-image-playground/api dev",
    "dev:full": "pnpm --parallel --filter gpt-image-playground --filter @gpt-image-playground/api dev",
    "mock:api": "node scripts/mock-image-api.mjs",
    "build": "tsc -b && vite build",
    "build:api": "pnpm --filter @gpt-image-playground/api build",
    "build:all": "pnpm build && pnpm build:api",
    "deploy:cf": "pnpm build && wrangler deploy",
    "preview": "vite preview",
    "test": "vitest run",
    "test:api": "pnpm --filter @gpt-image-playground/api test",
    "test:all": "pnpm test && pnpm test:api",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.0",
    "core-js": "^3.49.0",
    "fflate": "^0.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.5.0",
    "zustand": "^5.0.5"
  },
  "overrides": {
    "mdast-util-gfm-autolink-literal": "2.0.0",
    "dompurify": "^3.4.7"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.96.0"
  }
}
