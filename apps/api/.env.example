DATABASE_URL=postgresql://gpt_image:gpt_image@localhost:5432/gpt_image
SESSION_SECRET=change-me-to-a-long-random-secret
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
ADMIN_EMAILS=
ALLOW_PRIVATE_PROVIDER_URLS=false
RATE_LIMIT_ENABLED=true
IMAGE_MAX_UPLOAD_BYTES=67108864
IMAGE_MAX_PIXELS=67108864

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=gpt-image-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Backblaze B2 / external S3-compatible example:
# S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# S3_PUBLIC_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# S3_REGION=us-east-005
# S3_BUCKET=your-bucket
# S3_ACCESS_KEY_ID=your-key-id
# S3_SECRET_ACCESS_KEY=your-application-key
# S3_FORCE_PATH_STYLE=false

# Optional public CDN read URLs for public buckets, for example a Cloudflare
# proxied B2 download domain with a transform rule that prepends
# /file/<bucket-name> before origin fetches.
PUBLIC_IMAGE_BASE_URL=
PUBLIC_THUMBNAIL_READS=false
PUBLIC_ORIGINAL_READS=false

DEFAULT_PROVIDER_NAME=OpenAI
DEFAULT_PROVIDER=openai
DEFAULT_PROVIDER_BASE_URL=https://api.openai.com/v1
DEFAULT_PROVIDER_MODEL=gpt-image-2
DEFAULT_PROVIDER_API_MODE=images
DEFAULT_PROVIDER_API_KEY=
PROVIDER_KEY_ENCRYPTION_SECRET=change-me-to-32-bytes-or-more

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/better/callback/github

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/better/callback/google
